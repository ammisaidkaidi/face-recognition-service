APP_ENV=development
HOST=0.0.0.0
PORT=8000
DATABASE_URL=sqlite:///./data/app.db
VISION_BACKEND=insightface
MODEL_NAME=buffalo_l
MODEL_ROOT=./models
MODEL_VERSION=insightface-buffalo_l-v1
ONNX_PROVIDERS=CPUExecutionProvider
DETECTION_SIZE=640
RECOGNITION_THRESHOLD=0.45
MIN_FACE_SIZE=80
MIN_SHARPNESS=60.0
MIN_BRIGHTNESS=35.0
MAX_BRIGHTNESS=225.0
MAX_ABS_YAW=45.0
MAX_ABS_PITCH=35.0
PROCESS_FPS=10
MAX_FRAME_BYTES=2000000
ENROLLMENT_MIN_SAMPLES=5
ENROLLMENT_MAX_SAMPLES=20
POSE_DIVERSITY_DEGREES=10.0
STABILITY_FRAMES=3
UNKNOWN_HYSTERESIS_FRAMES=2
CORS_ORIGINS=http://localhost:3000
RETAIN_IMAGES=false
API_KEY=
LOG_LEVEL=INFO
